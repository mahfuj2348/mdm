{
  "name": "mdm",
  "version": "0.1.2",
  "description": "A download manager for Windows and macOS with parallel transfers and browser video capture",
  "main": "desktop/main.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mahfuj2348/mdm.git"
  },
  "bugs": {
    "url": "https://github.com/mahfuj2348/mdm/issues"
  },
  "author": "MDM",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs integration/*.test.cjs extension/*.test.cjs",
    "package": "electron-builder --mac dir",
    "dist": "electron-builder --mac dmg --publish never",
    "dist:zip": "electron-builder --mac zip --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "vendor": "node scripts/fetch-vendor.mjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.58.2"
  },
  "build": {
    "appId": "com.mdm.downloader",
    "productName": "MDM",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "renderer/**/*",
      "assets/**/*",
      "integration/**/*",
      "extension/**/*",
      "THIRD-PARTY.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "licenses/ffmpeg-static-LICENSE.txt"
      },
      {
        "from": "node_modules/googlevideo/LICENSE",
        "to": "licenses/googlevideo-LICENSE.txt"
      },
      {
        "from": "vendor",
        "to": "tools",
        "filter": [
          "*.txt",
          "yt-dlp_macos",
          "yt-dlp.exe"
        ]
      },
      {
        "from": "extension",
        "to": "browser/extension",
        "filter": [
          "**/*",
          "!*.test.cjs"
        ]
      },
      {
        "from": "integration",
        "to": "browser/integration",
        "filter": [
          "native-host.sh",
          "native-host.cjs",
          "README.md",
          "register-native-host.sh",
          "native-host.exe",
          "NativeHostLauncher.cs",
          "register-native-host.ps1"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "dmg": {
      "title": "MDM",
      "artifactName": "MDM-${version}-macOS-${arch}.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "MDM-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MDM-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "googlevideo": "^5.0.1"
  }
}
